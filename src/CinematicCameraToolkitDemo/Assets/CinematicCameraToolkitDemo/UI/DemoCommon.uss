/* ---------------------------------------------------------------------------
   デモ UI のパレット。ランタイム既定テーマ（明るいグレー）のままだと
   半透明の暗いパネルの上で浮くので、コントロール類まで暗色で塗り直す。
   --------------------------------------------------------------------------- */

.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* マージンガイド。left/right/top/bottom を百分率で駆動するため、
   RenderTargetMargin.Percentage の定義とそのまま一致する。 */
.framing-guide {
    position: absolute;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.55);
    border-right-color: rgba(255, 255, 255, 0.55);
    border-top-color: rgba(255, 255, 255, 0.55);
    border-bottom-color: rgba(255, 255, 255, 0.55);
}

/* マージンガイドの各辺に出す現在値。ガイド枠の内側へ貼り付ける。 */
.guide-value {
    position: absolute;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.85);
    background-color: rgba(16, 18, 22, 0.55);
    padding: 1px 4px;
    border-radius: 3px;
}

/* 左右の値は枠の下寄せ。上半分は操作パネルが縦に並ぶので、中央だと隠れる。 */
.guide-value--left {
    left: 4px;
    bottom: 6%;
}

.guide-value--right {
    right: 4px;
    bottom: 6%;
}

.guide-value--top {
    top: 4px;
    left: 50%;
    translate: -50% 0;
}

.guide-value--bottom {
    bottom: 4px;
    left: 50%;
    translate: -50% 0;
}

/* --- パネル ------------------------------------------------------------- */

.panel {
    position: absolute;
    width: 320px;
    padding: 10px;
    background-color: rgba(16, 18, 22, 0.82);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

/* 右列。左列（共通ヘッダ + デモ固有パネル）と反対側に置くもの。 */
.panel--right {
    right: 16px;
    top: 16px;
    max-height: 78%;
}

.panel-title {
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(235, 238, 245);
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.group {
    margin-bottom: 10px;
}

.group-title {
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(150, 205, 255);
    margin-bottom: 4px;
}

.row {
    flex-direction: row;
}

.tab {
    flex-grow: 1;
    height: 28px;
}

.tab.selected {
    background-color: rgb(58, 110, 165);
    border-color: rgb(96, 158, 220);
    color: rgb(255, 255, 255);
}

.flex-button {
    flex-grow: 1;
    height: 26px;
}

.value-label {
    margin-top: 4px;
    color: rgb(225, 225, 225);
}

.hint {
    margin-top: 4px;
    font-size: 10px;
    color: rgb(150, 155, 165);
    white-space: normal;
}

/* --- コントロール ------------------------------------------------------- */

Button {
    height: 26px;
    margin: 2px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(46, 50, 58);
    border-width: 1px;
    border-color: rgb(74, 80, 92);
    border-radius: 4px;
    color: rgb(228, 230, 235);
}

Button:hover {
    background-color: rgb(60, 66, 78);
    border-color: rgb(96, 104, 120);
}

Button:active {
    background-color: rgb(74, 82, 96);
}

Button:disabled {
    opacity: 0.45;
}

.unity-base-field__label {
    min-width: 96px;
    color: rgb(215, 215, 215);
}

/* テキスト入力（スライダーの数値欄）とドロップダウンの本体 */
.unity-base-text-field__input,
.unity-base-popup-field__input {
    background-color: rgb(30, 33, 39);
    border-width: 1px;
    border-color: rgb(74, 80, 92);
    border-radius: 4px;
    color: rgb(228, 230, 235);
}

.unity-base-popup-field__input:hover {
    background-color: rgb(42, 46, 54);
}

.unity-base-popup-field__text {
    color: rgb(228, 230, 235);
}

/* 矢印・チェックマークはテーマ側の暗い画像なので、明色へティントする */
.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(200, 205, 215);
}

.unity-toggle__checkmark {
    background-color: rgb(30, 33, 39);
    border-width: 1px;
    border-color: rgb(74, 80, 92);
    border-radius: 3px;
    -unity-background-image-tint-color: rgb(120, 185, 255);
}

.unity-toggle:hover .unity-toggle__checkmark {
    border-color: rgb(96, 104, 120);
}

/* スライダー。トラックは細く、つまみは明色の丸 */
.unity-base-slider__tracker {
    background-color: rgb(34, 37, 44);
    border-width: 1px;
    border-color: rgb(60, 66, 78);
    border-radius: 2px;
}

.unity-base-slider__dragger {
    background-color: rgb(150, 190, 235);
    border-width: 0;
    border-radius: 6px;
}

.unity-base-slider:hover .unity-base-slider__dragger {
    background-color: rgb(190, 215, 245);
}

/* --- スクロールバー ----------------------------------------------------- */

.unity-scroller {
    background-color: transparent;
    border-width: 0;
    width: 10px;
}

/* 上下の矢印ボタンは使わないので消す。細いバーだけ残す */
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroller .unity-base-slider {
    margin: 0;
}

.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 5px;
}

.unity-scroller .unity-base-slider__dragger {
    width: 8px;
    background-color: rgba(255, 255, 255, 0.28);
    border-radius: 4px;
}

.unity-scroller .unity-base-slider:hover .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.45);
}

/* --- 共通ヘッダ（DemoNavigationUI がコードで組む） --- */

/* キー操作の案内。hint より一段強くして、区切り線で他の要素から離す。 */
.key-hint {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
}

/* キーそのものはキートップ風の箱にして視線を集める。 */
.keycap {
    min-width: 24px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(235, 240, 250);
    background-color: rgb(52, 58, 70);
    border-width: 1px;
    border-color: rgb(110, 120, 140);
    border-radius: 4px;
    padding: 2px 7px;
    margin-right: 8px;
}

.key-hint__text {
    font-size: 12px;
    color: rgb(220, 226, 236);
}

.panel--navigation {
    left: 16px;
    top: 16px;
}

/* 案内が続く間は上の線だけでいいが、最後の 1 行は下も締めてボタンと分ける。 */
.key-hint--last {
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

/* キー案内の下に置くので、案内の行間と同じだけ離して独立させる。 */
#credits-button {
    margin-top: 10px;
}

/* 左列。共通ヘッダの下へ、UXML に書いた順で縦に積む。
   top は DemoNavigationUI が実測して入れる（ヘッダや前のパネルの高さで変わるため）。 */
.panel--under-navigation {
    left: 16px;
}

/* --- 権利表記オーバーレイ（DemoCreditsPanel がコードで組む） --- */

/* 画面全面を覆う。開いている間は panel.Pick がここを返すので、カメラ操作も止まる。 */
.credits-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}

/* .panel は absolute 配置なので、中央寄せが効くよう relative に戻す。
   表記は読ませるものなので、操作パネルより背景を濃くする。 */
.credits-panel {
    position: relative;
    width: 560px;
    max-width: 92%;
    max-height: 84%;
    padding: 20px 22px;
    background-color: rgba(16, 18, 22, 0.96);
}

.credits-list {
    flex-grow: 1;
}

/* ユニティちゃんライセンスのロゴ。暗いパネルに載せるので Dark 版（白抜き）を使う。
   140x121 の原寸比のまま縮める。 */
.ucl-logo {
    width: 112px;
    height: 97px;
    margin-bottom: 12px;
    align-self: center;
    background-image: url("../../ThirdParty/UnityChanKAGURA/License/UCL2.0/License Logo/Others/png/Dark_Silhouette.png");
    background-size: contain;
}

.credits-entry {
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.10);
}

.credits-entry__title {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(150, 205, 255);
    margin-bottom: 4px;
}

.credits-entry__body {
    font-size: 12px;
    color: rgb(220, 226, 236);
    white-space: normal;
}

/* URL はそのまま出してリンクにもする。長いものがあるので折り返す（切れると読めない）。 */
.credits-link {
    height: auto;
    max-width: 100%;
    margin: 4px 0 0 0;
    padding: 3px 6px;
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-left;
    align-self: flex-start;
    color: rgb(150, 190, 235);
    background-color: rgba(255, 255, 255, 0.04);
}

#credits-close {
    margin-top: 12px;
    align-self: flex-end;
    width: 96px;
}
